<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<!-- bean definitions here -->
	<bean name="emp" class="com.spring.model.Employee"
		autowire="constructor" scope="prototype">
		<constructor-arg name="id" value="111" />
		<constructor-arg name="name" value="Rakesh" />
		<constructor-arg name="gender" value="Male" />
	</bean>


	<bean name="address" class="com.spring.model.Address">
		<constructor-arg name="city" value="Noida" />
		<constructor-arg name="state" value="UP" />
	</bean>

</beans>
