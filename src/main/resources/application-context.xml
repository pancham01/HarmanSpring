<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<!-- bean definitions here -->
	<bean name="emp" class="com.spring.model.Employee" autowire="byName">
	<property name="gender" value="Male" />
	<property name="id" value="111" />
	<property name="name" value="Rakesh" />
</bean>


	<bean name="address" class="com.spring.model.Address">
		<property name="city" value="Noida" />
		<property name="state" value="UP" />
	</bean>



	<!-- <bean name="emp" class="com.spring.model.Employee">
		<constructor-arg name="id" value="111" />
		<constructor-arg name="name" value="Mohit" />
		<constructor-arg name="gender" value="Male" />
		<constructor-arg name="address" ref="" />
	</bean> -->

</beans>
